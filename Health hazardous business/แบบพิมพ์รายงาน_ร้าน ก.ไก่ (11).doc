      <table width="100%" cellpadding="0" cellspacing="0" style="margin-left: 15px; margin-top: 2pt;">
        <tr>
          <td width="22%">6. จำนวนพนักงานทั้งหมด</td><td class="u" width="15%" align="center">6</td><td width="8%">คน</td>
          <td width="8%">ชาย</td><td class="u" width="15%" align="center">1</td><td width="8%">คน</td>
