      <table width="100%" cellpadding="0" cellspacing="0" style="margin-left: 15px; margin-top: 6pt;">
        <tr>
          <td width="15%">5. จำนวนเครื่องจักร</td><td class="u" width="15%" align="center">1</td><td width="8%">ตัว</td>
          <td width="20%">รวมจำนวนแรงม้า</td><td class="u" width="15%" align="center">100</td><td width="15%">แรงม้า</td>
        </tr>
