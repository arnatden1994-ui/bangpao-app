          <td width="18%">7. ระยะเวลาการทำงาน</td><td class="u" width="10%" align="center">7</td><td width="18%">วัน/สัปดาห์ ตั้งแต่เวลา</td>
          <td class="u" width="15%" align="center">8:00</td><td width="10%">น. ถึงเวลา</td>
